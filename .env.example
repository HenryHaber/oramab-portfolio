# SMTP configuration for the contact form (Nodemailer)
# Copy this file to .env.local and fill in real values.

# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=oramabo.emmanuel@gmail.com
# SMTP_PASS=<your Gmail App Password>   (generate at https://myaccount.google.com/apppasswords)
# SMTP_FROM=oramabo.emmanuel@gmail.com
# CONTACT_TO=oramabo.emmanuel@gmail.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=