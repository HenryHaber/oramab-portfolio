# Contact form configuration for static (GitHub Pages) hosting.
# Copy this file to .env.local and fill in the email that should receive
# contact messages (defaults to the CV email in data/profile.ts).

NEXT_PUBLIC_CONTACT_EMAIL=oramabo.emmanuel@gmail.com

# Optional: override the FormSubmit endpoint entirely.
# NEXT_PUBLIC_FORM_ENDPOINT=https://formsubmit.co/ajax/oramabo.emmanuel@gmail.com